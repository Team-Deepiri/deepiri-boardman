# =============================================================================
# REQUIRED — set these for normal Plaky ↔ GitHub operation
# =============================================================================
#
# Docker: copy this file to `.env` in the repo root. `docker compose` loads it via `env_file`
# (do not bake `.env` into the image — it is in `.dockerignore`). Avoid duplicating secrets in
# compose `environment: KEY=${KEY}`; an empty interpolation can override `env_file` and clear the key.

# [REQUIRED] Plaky API (tasks, comments, CLI list/create)
PLAKY_API_KEY=your_plaky_api_key_here

# [REQUIRED] GitHub REST API: org repo discovery, scan, DIRECTION init, agent tools
GITHUB_PAT=your_github_personal_access_token_here

# --- Local "as-if-production" poller ---
# While this instance runs, a background poller pulls new GitHub activity for the repos
# below and routes it through the same handlers as the production webhook, so Plaky
# updates live ONLY while this machine runs. Set false in production; real webhooks
# deliver events there and the poller stays off.
# TESTING_LIVE_PLAKY=false
# `all` (or `*`, or `auto`) watches every non-archived repo in GITHUB_ORG that resolves to
# a Plaky board; repos with no Plaky destination are logged with the reason and skipped, never
# guessed at. A comma-separated owner/repo list pins the poller to exactly those repos.
# TESTING_LIVE_PLAKY_REPOS=all
# TESTING_LIVE_PLAKY_POLL_SECONDS=60

# [REQUIRED] Must match the secret on the GitHub webhook. Empty = signature check
# disabled (local dev only; do not use in production)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Production uses the SQLite worker for webhook mutations; leave false only for
# local inline-handler testing without boardman-worker.
GITHUB_WEBHOOK_ASYNC_ENABLED=false
GITHUB_WEBHOOK_JOB_RETRIES=2
GITHUB_RECONCILE_ENABLED=false
GITHUB_RECONCILE_INTERVAL_SECONDS=900
GITHUB_RECONCILE_MAX_ITEMS=50
# Webhook should subscribe to: Issues, Pull requests, Pull request reviews, Issue comments


# =============================================================================
# OPTIONAL — defaults are fine unless you need to override
# =============================================================================

# --- Plaky ---
# Official public API base (X-API-Key auth). Old /v2 + Bearer was wrong for Plaky’s docs.
PLAKY_API_BASE=https://api.plaky.com/v1/public
PLAKY_PR_MERGE_STATUS=in_review
# When true, merge webhook sets PLAKY_PR_MERGE_STATUS only after every linked PR is merged or closed.
PLAKY_COMPLETE_WHEN_ALL_PRS_MERGED=true
# QA automation (must match your Plaky status keys). Empty = skip that transition.
# PLAKY_PR_NEEDS_QA_STATUS=needs_qa
# Live QA hardware capability board — one Plaky item per teammate, replacing hand-typed
# `tier:` in team_assignments.yml. Optional: unset means "not using this yet", and
# qa_picker falls back to team_assignments.yml's tier unchanged. Create the board first
# (the public API cannot create boards), then run `boardman capability-report` per
# machine per teammate. See boardman/assignment/capability_board.py.
# PLAKY_CAPABILITY_BOARD_ID=
# PLAKY_CAPABILITY_GROUP_ID=
# PLAKY_PR_IN_QA_STATUS=in_qa
# PLAKY_PR_QA_APPROVED_STATUS=qa_approved
# PLAKY_PR_QA_REJECTED_STATUS=qa_rejected
# PLAKY_SKIP_NEEDS_QA_FOR_DRAFT=true
# After Plaky status updates, enqueue SQLite job `plaky_reorder_group_job` (needs boardman-worker).
# PLAKY_REORDER_AFTER_STATUS_CHANGE=false
# Comma-separated substrings for “done” detection when reordering items in a group.
# PLAKY_REORDER_DONE_STATUS_MARKERS=done,complete,closed,resolved,archive,shipped,merged
# Blend word-bag cosine into PR↔task fuzzy score (0 = legacy SequenceMatcher only).
# PR_LINKING_COSINE_WEIGHT=0.35
# Placement for tasks and GitHub→Plaky flows: pass board/group on the API / chat request, set agent context, or
# configure repos.yml per-repo or under `defaults` (see repos.yml). Startup field-key sync uses defaults.plaky_board_id only.
# Live pytest: use Boardman Test Board + test group (see tests/plaky_test_board.py). Optional ID overrides:
# PLAKY_BOARDMAN_TEST_BOARD_ID=  PLAKY_BOARDMAN_TEST_GROUP_ID=  # name-based discovery if unset
# PLAKY_BOARDMAN_TEST_GROUP_NAME=  # default group display name (default: Sprint 2)

# --- GitHub ---
# Org for API repo listing and routing (default: deepiri-org)
GITHUB_ORG=deepiri-org
# Owner prepended when CLI/UI passes a repo name without "owner/repo" (QA roster, tags). Default Team-Deepiri.
# Empty = use GITHUB_ORG for bare slugs.
# GITHUB_BARE_REPO_OWNER=Team-Deepiri
# Roster for names/logins: GET /api/v1/github/support-team/members (PAT needs read:org to see the team)
# GITHUB_SUPPORT_TEAM=Team-Deepiri/support-team
# GITHUB_SKIP_ARCHIVED=true
# Scan GET /orgs/{org}/teams for slug/name patterns (qa-tier-3, t2-qa, "Tier 2 …"). Members get that qa_tier.
# If no teams match, Phase 1 uses decayed PR activity only. Token needs read:org.
# GITHUB_QA_TIER_TEAM_SCAN_ENABLED=true
# GITHUB_QA_ACTIVITY_HALF_LIFE_DAYS=180
# GITHUB_QA_ACTIVITY_SEARCH_MAX_PAGES=5
# GITHUB_QA_ACTIVITY_TIER3_MIN_DISTINCT_T3_REPOS=2
# GITHUB_QA_ACTIVITY_TIER3_MIN_WEIGHTED_SCORE=5
# GITHUB_QA_ACTIVITY_TIER2_MIN_DISTINCT_T2PLUS_REPOS=3
# GITHUB_QA_ACTIVITY_TIER2_MIN_WEIGHTED_SCORE=2.5
# Max active (open, not merged/withdrawn) PRs a QA can be assigned before the picker
# skips them. All-at-cap fallback picks the least-loaded reviewer. Default 5.
# QA_MAX_ACTIVE_PRS=5
# DEFAULT_REPO_CATEGORY=
# DEFAULT_PLAKY_TABLE=

# --- Service & database ---
DATABASE_URL=sqlite+aiosqlite:///./boardman.db
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8090
LOG_LEVEL=INFO

# --- Repo routing (see repos.yml) ---
# REPOS_YML_PATH=repos.yml
# TEAM_ASSIGNMENTS_YML_PATH=team_assignments.yml
# Bearer secret for POST /api/v1/assignment/pick-qa (Cloudflare Worker or cron). Empty = route disabled.
# WORKER_INTERNAL_SECRET=
# Public bearer secret for the Cloudflare Worker POST /assign-qa route.
# Keep this in Cloudflare Worker secrets as ROUTE_SECRET too.
# ROUTE_SECRET=
# Optional fallback team list for the Cloudflare Worker when BOARDMAN_URL proxying is not configured.
# QA_TEAM_JSON=

# --- PR ↔ Plaky fuzzy linking (pull_request.opened when body has no Fixes/Closes #issue) ---
# On by default. Set PR_LINKING_PIPELINE_ENABLED=false to disable. Uses DB + optional board scan,
# score bands, optional LLM rerank (PR_LINKING_LLM_ENABLED=true).
# PR_LINKING_PIPELINE_ENABLED=true
# PR_LINKING_FETCH_BOARD_ITEMS=true
# PR_LINKING_MAX_BOARD_ITEMS_SCAN=200
# PR_LINKING_BOARD_MAX_PAGES=10
# PR_LINKING_HIGH_THRESHOLD=90
# PR_LINKING_MEDIUM_THRESHOLD=50
# PR_LINKING_TOP_N_FOR_LLM=5
# PR_LINKING_LLM_ENABLED=false
# PR_LINKING_LLM_MIN_CONFIDENCE=0.75

# --- Background jobs (SQLite `background_jobs` + boardman-worker container) ---
# POST /api/v1/agent/chat with "queue": true enqueues; poll GET /api/v1/agent/jobs/{job_id}
# AGENT_ASYNC_ENQUEUE_ENABLED=true
# Worker idle poll and stale-running cleanup (optional):
# QUEUE_WORKER_POLL_SECONDS=0.25
# QUEUE_WORKER_STALE_RUNNING_SECONDS=7200
# Leaky-bucket on /agent/chat and /agent/scan (per client IP):
# AGENT_RATE_LIMIT_ENABLED=true
# AGENT_RATE_LIMIT_CAPACITY=16
# AGENT_RATE_LIMIT_LEAK_PER_SECOND=0.5
# Shared bucket state in SQLite (multi-instance). Legacy alias: AGENT_RATE_LIMIT_USE_REDIS
# AGENT_RATE_LIMIT_USE_SQLITE=false

# Plaky board schema cache for faster agent turns (seconds; 0 = off)
# Plaky board/group catalog for repo -> placement auto-discovery.
# PLAKY_CATALOG_CACHE_PATH=.boardman/plaky-catalog.json
# PLAKY_CATALOG_TTL_SECONDS=86400
# PLAKY_PLACEMENT_AUTO_DISCOVER=true
# PLAKY_PLACEMENT_MIN_SCORE=400
# PLAKY_CATALOG_CATEGORICAL_ONLY=true  # drop legacy sprint boards via group-structure heuristic

# Plaky board schema cache (status field discovery on a board).
# PLAKY_BOARD_SCHEMA_CACHE_TTL_SECONDS=90

# Progressive GitHub repo context (seconds; set the first to 0 to disable process cache).
# GITHUB_READ_CACHE_TTL_SECONDS=300
# AGENT_REPO_CONTEXT_CACHE_TTL_SECONDS=900
# AGENT_REPO_CONTEXT_STALE_IF_ERROR_SECONDS=86400

# --- LLM ---
# Local/dev only: Ollama can run through docker-compose.yml for CPU/GPU validation.
# Cloud production must use docker-compose.prod.yml and should not set LLM_PROVIDER=ollama.
# Ollama: leave LLM_MODEL unset to auto-pick from GET /api/tags (qwen > llama > …). Optional override:
# LLM_MODEL=qwen2.5:7b
# LLM_PROVIDER=ollama
# Host / poetry: localhost. Docker Compose pins boardman to http://ollama:11434 (this value is ignored there).
OLLAMA_BASE_URL=http://localhost:11434
# Keep model loaded between requests (reduces cold-start latency). Empty = Ollama default.
OLLAMA_KEEP_ALIVE=30m
# Docker Compose GPU path for the Ollama sidecar:
# - CPU-only hosts: leave OLLAMA_DOCKER_RUNTIME unset.
# - NVIDIA hosts: prefer `sudo nvidia-ctk runtime configure --runtime=docker --set-as-default`.
# - If Docker cannot use nvidia as the default runtime, uncomment this explicit service runtime.
# OLLAMA_DOCKER_RUNTIME=nvidia
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Optional max new tokens per completion (plain chat + LangChain). Lower = faster; unset = Ollama default.
# OLLAMA_NUM_PREDICT=512
# Plain chat UI uses POST /api/v1/agent/chat/stream (SSE) for snappier perceived latency — no token cap required.
OPENAI_API_KEY=
# OpenRouter (OpenAI-compatible). Use provider/model like:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=anthropic/claude-3.5-sonnet
# Other examples:
#   openai/gpt-4o-mini
#   google/gemini-2.0-flash-001
#   meta-llama/llama-3.1-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional headers recommended by OpenRouter:
OPENROUTER_REFERER=
OPENROUTER_APP_TITLE=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Meeting plans (`boardman plan weekly|custom`) ---
# Copy team_repos.example.json → team_repos.json and team_plaky_boards.example.json → team_plaky_boards.json
# PLANNING_TEAM_REPOS_FILE=team_repos.json
# PLANNING_TEAM_PLAKY_BOARDS_FILE=team_plaky_boards.json
# PLANNING_GITHUB_LOOKBACK_DAYS=14
# PLANNING_PLAKY_LOOKBACK_DAYS=14
# PLANNING_SYNC_LOOKBACK_DAYS=7
# PLANNING_DIRECTION_CACHE_HOURS=24
# PLANNING_DIRECTION_EXCERPT_CHARS=500

# --- Agent ---
# Optional Redis for API-side caching only (e.g. Plaky board schema). Not used by boardman-worker.
# Production: leave unset. Docker: `docker compose --profile agent-cache up -d` then e.g.:
# AGENT_REDIS_URL=redis://redis:6379/1
AGENT_MAX_HISTORY=50
AGENT_REQUIRE_CONFIRM_BULK=true
PROMPT_VERSION=2026-04-09
AGENT_LANGCHAIN_TOOLS=true
# Max LangGraph steps when multi-step tools are used (POST body use_tools: true or UI toggle).
AGENT_RECURSION_LIMIT=22
# Fast path: POST /api/v1/agent/chat omits use_tools or sends false → one LLM call. Send use_tools: true
# (or enable “Multi-step agent” in boardman-ui) when you need the tool loop.
# Verbose LangChain step traces (dev only; very noisy)
# AGENT_LANGCHAIN_VERBOSE=false
# --- Tunable analysis limits (defaults in boardman/settings.py; 0 = use the default) ---
# Repo names injected into the system prompt. A bigger org truncates with a visible note.
# AGENT_ORG_ROSTER_MAX_NAMES=200
# Replies shorter than this are checked for "let me fetch that" dead ends; longer replies
# are treated as substantive. Raise if a model ships longer bare promises.
# AGENT_PREAMBLE_MAX_CHARS=600
# Character budget for the repo planning payload handed to the model.
# LLM_CONTEXT_BUDGET_CHARS=24000
# Pull-request reading: changed files listed, and body characters kept.
# GITHUB_PR_MAX_FILES=40
# GITHUB_PR_MAX_BODY_CHARS=4000
# Code search / defect scan: how many of the largest source files are read, and how much
# of each. More files means more GitHub calls per audit-style question.
# GITHUB_CODE_SEARCH_MAX_FILES=16
# GITHUB_CODE_SEARCH_MAX_BYTES_PER_FILE=120000
# How many of the busiest repos get their open issues split from their open PRs. Each one
# costs an extra GitHub call, because open_issues_count includes pull requests. Unlike the
# limits above, 0 is honoured here and means "make no extra calls"; use -1 for the default.
# GITHUB_ORG_ACTIVITY_SPLIT_TOP_N=8
# Extra committed-artifact detections for repo hotspots, on top of the built-in list
# (.env, .db, .pem, id_rsa, ...). Format: "marker:why it matters", SEMICOLON-separated --
# reasons are prose and prose has commas in it. The reason is optional. A marker is a
# filename ENDING (at least 3 characters, no spaces), so ".tfstate" catches main.tfstate
# and "id_ed25519" does not catch id_ed25519.pub. A version or backup tail after the
# marker still counts -- main.tfstate.bak, prod.tfstate.2, main.tfstate~ -- because that
# is a copy of the same secret, not a different kind of file.
# GITHUB_EXTRA_ARTIFACT_RULES=id_ed25519:private SSH key tracked in git;.tfstate:terraform state, with secrets
# Local without Docker: UVICORN_RELOAD=1 poetry run python -m boardman.main

# Comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176,http://localhost:8088,http://127.0.0.1:8088
